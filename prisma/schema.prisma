generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  youtubeChannelId    String?
  youtubeChannelTitle String?
  youtubeAvatarUrl    String?
  youtubeBannerUrl    String?
  youtubeLinkedAt     DateTime?
  youtubeChannels     YoutubeChannel[]
  accounts      Account[]
  sessions      Session[]
  videoProjects VideoProject[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model YoutubeChannel {
  id           String   @id @default(cuid())
  userId       String
  channelId    String
  title        String?
  avatarUrl    String?
  bannerUrl    String?
  isActive     Boolean  @default(false)
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId, isActive])
}

enum VideoProjectStage {
  IDEA
  DRAFTING
  RECORDING
  EDITING
  PUBLISHED
  REVIEW
}

model VideoProject {
  id               String            @id @default(cuid())
  userId           String
  title            String
  concept          String?
  notes            String?
  stage            VideoProjectStage @default(IDEA)
  nextStep         String?
  targetPublishAt  DateTime?
  youtubeChannelId String?
  
  // Title Ideation
  proposedTitles   String?           // JSON array of suggested titles
  shortlistedTitles String?          // JSON array of user-saved title candidates
  selectedTitle    String?           // User's chosen title
  
  // Hook Generation
  proposedHooks    String?           // JSON array of suggested hooks
  shortlistedHooks String?           // JSON array of user-saved hook candidates
  selectedHook     String?           // User's chosen hook
  
  // Angle Sharpening
  proposedAngle    String?           // AI's angle clarification
  selectedAngle    String?           // User's chosen/refined angle
  
  // Thumbnail Direction
  proposedThumbnailDirection  String?  // AI's thumbnail suggestions
  shortlistedThumbnailDirection String? // JSON array of user-saved thumbnail candidates
  selectedThumbnailDirection  String?  // User's chosen direction
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, stage])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  refresh_token_expires_in Int?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
